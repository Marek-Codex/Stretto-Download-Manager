    <x:String x:Key="IconDetails">&#xE946;</x:String>
    <x:String x:Key="IconSelectNone">&#xE8E6;</x:String>
    <x:String x:Key="IconSort">&#xE8CB;</x:String>
    <x:String x:Key="IconMore">&#xE712;</x:String>
</ResourceDictionary>
