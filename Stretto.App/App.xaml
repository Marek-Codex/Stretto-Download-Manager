<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Stretto.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Assets/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ═══ Accent Palette ═══ -->
            <!-- The Plexus family accent. Shared across the apps on purpose, so status
                 colours below carry meaning and the accent only ever means "this app". -->
            <Color x:Key="StrettoAccentColor">#FF3CA0FF</Color>
            <Color x:Key="StrettoAccentLightColor">#FF52ABFF</Color>
            <Color x:Key="StrettoAccentDarkColor">#FF2784D8</Color>
            <SolidColorBrush x:Key="StrettoAccentBrush" Color="{StaticResource StrettoAccentColor}" />
            <SolidColorBrush x:Key="StrettoAccentSoftBrush" Color="#183CA0FF" />
            <SolidColorBrush x:Key="StrettoAccentSoftHoverBrush" Color="#263CA0FF" />
            <SolidColorBrush x:Key="StrettoAccentStrokeBrush" Color="#443CA0FF" />

            <!-- The system accent ramp itself. Overriding only the Accent*Brush keys is not
                 enough: several control templates (AccentButtonStyle hover and pressed,
                 ToggleSwitch, CheckBox, SelectorBar) read these colours directly, so without
                 them primary buttons came out in the Windows cyan rather than the family blue.
                 Dark theme fills with Light2, so Light2 is the brand colour exactly. -->
            <Color x:Key="SystemAccentColor">#FF3CA0FF</Color>
            <Color x:Key="SystemAccentColorLight1">#FF52ABFF</Color>
            <Color x:Key="SystemAccentColorLight2">#FF3CA0FF</Color>
            <Color x:Key="SystemAccentColorLight3">#FF6CB8FF</Color>
            <Color x:Key="SystemAccentColorDark1">#FF2784D8</Color>
            <Color x:Key="SystemAccentColorDark2">#FF1F6DB5</Color>
            <Color x:Key="SystemAccentColorDark3">#FF175592</Color>

            <!-- ═══ Status Colors ═══ -->
            <SolidColorBrush x:Key="StrettoPausedBrush" Color="#FFF4B860" />
            <SolidColorBrush x:Key="StrettoErrorBrush" Color="#FFFF6B6B" />
            <SolidColorBrush x:Key="StrettoDoneBrush" Color="#FF55CBA7" />
            <SolidColorBrush x:Key="StrettoPendingBrush" Color="#FF8B9AA8" />
            <SolidColorBrush x:Key="StrettoTrackBrush" Color="#14FFFFFF" />

            <!-- ═══ Surface Colors ═══ -->
            <SolidColorBrush x:Key="StrettoCardBrush" Color="#0AFFFFFF" />
            <SolidColorBrush x:Key="StrettoCardHoverBrush" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="StrettoCardBorderBrush" Color="#18FFFFFF" />
            <SolidColorBrush x:Key="StrettoSidebarBrush" Color="#08FFFFFF" />
            <SolidColorBrush x:Key="StrettoSidebarBorderBrush" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="StrettoBarBrush" Color="#0CFFFFFF" />
            <!-- Secondary window shells. Transparent so their Mica shows through, the way the
                 main window's root does; an opaque navy here painted over the backdrop and
                 left every other window a flat slab beside the main one. -->
            <SolidColorBrush x:Key="StrettoWindowBrush" Color="Transparent" />
            <!-- Hairline between a window's content and its button row, and between
                 rows inside a settings card. -->
            <SolidColorBrush x:Key="StrettoDividerBrush" Color="#12FFFFFF" />
            <!-- Footer strip, one step up from the window so the buttons read as a bar
                 rather than as more content. A tint over Mica, not a solid, for the same reason. -->
            <SolidColorBrush x:Key="StrettoFooterBrush" Color="#0CFFFFFF" />

            <!-- Type scale. Set at the sizes already in use, so naming them changes nothing
                 on screen: this is here to stop the next control inventing a fourteenth
                 size. Eight values were previously doing the work of five. -->
            <x:Double x:Key="StrettoTextDisplay">22</x:Double>
            <x:Double x:Key="StrettoTextTitle">15</x:Double>
            <x:Double x:Key="StrettoTextBody">13</x:Double>
            <x:Double x:Key="StrettoTextLabel">12.5</x:Double>
            <x:Double x:Key="StrettoTextCaption">12</x:Double>
            <x:Double x:Key="StrettoTextHint">11.5</x:Double>

            <!-- Inline icons sit beside body text and are sized with it, not as text. -->
            <x:Double x:Key="StrettoIconInline">15</x:Double>

            <!-- Geometry. Cards and lists share one radius; controls inside them a smaller
                 one. Five different radii were in use, which reads as unfinished rather
                 than as a choice. -->
            <CornerRadius x:Key="StrettoRadiusCard">8</CornerRadius>
            <CornerRadius x:Key="StrettoRadiusControl">6</CornerRadius>

            <!-- Shared dialog surface, so compact prompts and larger tools feel related. -->
            <Style x:Key="StrettoDialogSurface" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource StrettoCardBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource StrettoCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>

            <Style x:Key="StrettoDialogList" TargetType="ListView">
                <Setter Property="Background" Value="{StaticResource StrettoCardBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource StrettoCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <!-- ═══ Accent Overrides (WinUI system brushes) ═══ -->
            <!-- These have to live in ThemeDictionaries, not at the dictionary root.
                 WinUI's AccentButtonStyle reaches for them with ThemeResource, which
                 resolves against the theme dictionaries first and otherwise keeps
                 finding the system accent, leaving primary buttons Windows blue. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF3CA0FF" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FF52ABFF" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FF2784D8" />
                    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FF3CA0FF" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FF07131F" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#CC07131F" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF2784D8" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FF2274BD" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FF1C63A2" />
                    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FF16507F" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#CCFFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
