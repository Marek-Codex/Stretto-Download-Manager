<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Stretto.App.Dialogs.NewDownloadDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- WinUI's own compact density, scoped to this window rather than set app
                     wide: the main window is somewhere you sit and read, the secondary ones
                     are somewhere you pass through, and they should feel tighter for it. -->
                <ResourceDictionary Source="ms-appx:///Assets/Density.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{StaticResource StrettoTextLabel}" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Labels above their fields, the Fluent form layout, rather than a column of
         captions down the left. The link leads because it is the only required field. -->
    <!-- Wide and short: the link gets the full width, name and destination share a row
         beneath it. Three stacked rows made a tall narrow window for what is one line of
         input and two optional ones. -->
    <StackPanel x:Name="FormRoot" Spacing="12" Width="620">
        <Grid ColumnSpacing="12" RowSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.ColumnSpan="2" Spacing="5">
                <TextBlock Text="Link" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="AddressBox" PlaceholderText="https://" TextChanged="Address_TextChanged" />
                <TextBlock x:Name="SourceSummary" FontSize="{StaticResource StrettoTextHint}" Opacity="0.7"
                           MinHeight="16" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel Grid.Row="1" Spacing="5" VerticalAlignment="Top">
                <TextBlock Text="File name" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="FileNameBox" PlaceholderText="As the server names it" TextChanged="FileName_TextChanged" />
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="5">
                <TextBlock Text="Save to" Style="{StaticResource FieldLabel}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="SaveInBox" HorizontalAlignment="Stretch" SelectionChanged="SaveIn_SelectionChanged">
                        <ComboBoxItem Content="Choose by file type" IsSelected="True" />
                        <ComboBoxItem Content="Downloads folder" />
                        <ComboBoxItem Content="Choose a folder" />
                    </ComboBox>
                    <Button Grid.Column="1" x:Name="BrowseButton" Click="Browse_Click" Padding="10,6" ToolTipService.ToolTip="Browse">
                        <FontIcon Glyph="{StaticResource IconFolder}" FontSize="{StaticResource StrettoIconInline}" />
                    </Button>
                </Grid>
                <!-- One line, trimmed: the window is sized once on open, so a hint that wrapped later
                     pushed the footer buttons out of view. The full text is in the tooltip. -->
                <TextBlock x:Name="SaveInHint" FontSize="{StaticResource StrettoTextHint}" Opacity="0.65" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <!-- Only shown for browser captures. -->
        <HyperlinkButton x:Name="IgnoreHostLink" Click="IgnoreHost_Click" Padding="0"
                         Visibility="Collapsed" HorizontalAlignment="Left" FontSize="{StaticResource StrettoTextLabel}" />

        <Grid x:Name="ButtonRow" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="AdvancedSettingsButton" Click="More_Click" Padding="10,6" VerticalAlignment="Center"
                    ToolTipService.ToolTip="Login, proxy and connections for this download">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon Glyph="{StaticResource IconSettings}" FontSize="13" />
                    <TextBlock Text="Options" />
                </StackPanel>
            </Button>
            <!-- Says what Options has changed, so a login or proxy override is not
                 invisible once its window is closed. -->
            <TextBlock x:Name="AdvancedSummary" Grid.Column="1" FontSize="11.5" VerticalAlignment="Center"
                       Foreground="{StaticResource StrettoAccentBrush}" TextTrimming="CharacterEllipsis" />
            <!-- Named for what happens rather than when: it starts, or it goes in a queue. -->
            <Button x:Name="DownloadNowButton" Grid.Column="2" Content="Download"
                    Click="DownloadNow_Click" Padding="12,6" MinWidth="88" Style="{StaticResource AccentButtonStyle}" />
            <Button x:Name="DownloadLaterButton" Grid.Column="3" Click="DownloadLater_Click" Padding="12,6" MinWidth="88">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Add to queue" />
                    <FontIcon Glyph="&#xE70D;" FontSize="10" Opacity="0.7" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Grid.Column="4" Content="Cancel" Click="Cancel_Click" Padding="12,6" MinWidth="88" />
        </Grid>

    </StackPanel>
</UserControl>
