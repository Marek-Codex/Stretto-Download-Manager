<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Stretto.App.Dialogs.VideoDownloadDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    >

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- WinUI's own compact density, scoped to this window rather than set
                     app wide: secondary windows are passed through, not sat in. -->
                <ResourceDictionary Source="ms-appx:///Assets/Density.xaml" />
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </UserControl.Resources>

    <!-- One window, one job. The browser feed lives in its own window: it is used while
         browsing and wants to stay on top, which this one does not. -->
    <Grid Width="560" Height="380" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="AddressBox" PlaceholderText="Paste a page or playlist address" KeyDown="Address_KeyDown" />
            <Button x:Name="FindButton" Grid.Column="1" Click="Find_Click" Padding="12,5">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="{StaticResource IconSearch}" FontSize="13" />
                    <TextBlock Text="Find" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Status and Select all share a line: both describe the list below it. -->
        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="SelectAllCheck" Content="Select all" Click="SelectAll_Click" Visibility="Collapsed" MinWidth="0" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <!-- Collapsed when idle: an inactive ring still reserves its width. -->
                <ProgressRing x:Name="Busy" IsActive="False" Visibility="Collapsed" Width="14" Height="14" />
                <TextBlock x:Name="StatusText" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Finds video and audio on a page. Playlists and video sites need yt-dlp." />
            </StackPanel>
        </Grid>

        <!-- Quality sits on each row, the same as in the media grabber, rather than in a
             side pane that stood empty for every plain file. -->
        <ListView x:Name="ResultsList" Grid.Row="2" SelectionMode="Multiple"
                  SelectionChanged="Results_SelectionChanged"
                  ScrollViewer.HorizontalScrollMode="Disabled"
                  Style="{StaticResource StrettoDialogList}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnSpacing="10" Padding="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <Border Padding="6,1" CornerRadius="4" VerticalAlignment="Center"
                                        Background="{StaticResource StrettoAccentSoftBrush}"
                                        Visibility="{Binding BadgeVisibility}">
                                    <TextBlock Text="{Binding Badge}" FontSize="10"
                                               Foreground="{StaticResource StrettoAccentBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Address}" FontSize="11" Opacity="0.55"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" VerticalAlignment="Center" MinWidth="140"
                                  ItemsSource="{Binding Formats}" SelectedItem="{Binding Chosen, Mode=TwoWay}"
                                  PlaceholderText="Auto" DisplayMemberPath="Label"
                                  Visibility="{Binding FormatsVisibility}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Says what to do next rather than only that nothing is here: the same soft accent
             tile the Finished window and list rows use, a heading, and one line of how. -->
        <StackPanel x:Name="EmptyResults" Grid.Row="2" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360">
            <Border Width="48" Height="48" CornerRadius="10" HorizontalAlignment="Center" Margin="0,0,0,6"
                    Background="{StaticResource StrettoAccentSoftBrush}">
                <FontIcon Glyph="{StaticResource IconVideoGrab}" FontSize="22" Foreground="{StaticResource StrettoAccentBrush}" />
            </Border>
            <TextBlock Text="Paste a page or playlist address" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="Every video, stream and audio file Stretto finds appears here. Choose a quality for each, then download them together."
                       FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </StackPanel>

        <!-- Offered in place, so a missing helper is one click rather than a trip to Settings. -->
        <Border x:Name="InstallBar" Grid.Row="3" Visibility="Collapsed" Padding="10,6" CornerRadius="6"
                Background="{StaticResource StrettoAccentSoftBrush}">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4" VerticalAlignment="Center">
                    <TextBlock x:Name="InstallText" FontSize="12" TextWrapping="Wrap" />
                    <ProgressBar x:Name="InstallProgress" Visibility="Collapsed" Maximum="1" />
                </StackPanel>
                <Button x:Name="InstallButton" Grid.Column="1" Click="Install_Click" Padding="12,4" />
            </Grid>
        </Border>

        <TextBlock x:Name="SaveInText" Grid.Row="4" FontSize="11.5" Opacity="0.6" TextTrimming="CharacterEllipsis" />
    </Grid>
</UserControl>
